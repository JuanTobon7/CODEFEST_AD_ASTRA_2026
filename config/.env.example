# ============================================================
#  Configuración del pipeline de ingesta — CODEFEST AD ASTRA 2026
#  Copia este archivo a `.env` y ajusta los valores.
# ============================================================

# --- MongoDB -------------------------------------------------
MONGO_URI=mongodb://localhost:27017
MONGO_DB=rag_corpus
MONGO_COLLECTION=chunks
# Solo si tu MongoDB requiere autenticación:
MONGO_USER=admin
MONGO_PASSWORD=admin
MONGO_AUTH_SOURCE=admin

# --- Repositorio de chunks -------------------------------------
# json guarda todos los fragmentos en un unico archivo con la metadata de la Tabla 1.
# Usa mongo solo si necesitas mantener la persistencia anterior.
CHUNK_REPOSITORY=json
CHUNKS_JSON_PATH=data/chunks.json

# --- Chunking (estrategia híbrida) ----------------------------
# Estrategia: structural | semantic | hybrid
CHUNKING_STRATEGY=hybrid
CHUNK_SIZE=400
OVERLAP_SIZE=80
MIN_CHUNK_TOKENS=50
# Límite del encoder (no superar 512 para la mayoría de encoders)
MAX_TOKENS=512

# --- Tokenizador y segmentación de oraciones -------------------
# Tokenizador WordPiece de BERT (transformers), mismo checkpoint que el encoder bert-multilingual
TOKENIZER_MODEL=google-bert/bert-base-multilingual-cased
# Modelo spacy para segmentar oraciones (es/en/pt)
SENTENCE_MODEL=es_core_news_sm
# Idioma por defecto si la detección automática falla
DEFAULT_LANGUAGE=es

# --- Documento --------------------------------------------------
DEFAULT_FUENTE=documento

# --- Embeddings (Sección 4: codificación semántica) --------------
# e5-multilingual-base/small: benchmark de retrieval publicado (MIRACL) +
# granularidad alta/baja; bert-multilingual: espacio vectorial BERT puro
# distinto, aporta diversidad a la fusión RRF (Sección 4.3/4.4).
ACTIVE_ENCODERS=e5-multilingual-base,e5-multilingual-small,bert-multilingual
# Overrides opcionales por encoder si un checkpoint no cabe bien en la misma VRAM:
# EMBEDDING_BATCH_SIZE_OVERRIDES=bert-large=8,e5-multilingual-small=64
EMBEDDING_BATCH_SIZE_OVERRIDES=
EMBEDDING_DEVICE=auto
EMBEDDING_OUTPUT_DIR=base_vectorial
MONGO_COLLECTION_CHUNKS=chunks
MONGO_COLLECTION_EMBEDDINGS_CACHE=embeddings_cache

# --- Vectorstore / FAISS (Sección 5: índices por encoder) --------
MONGO_COLLECTION_EMBEDDINGS=embeddings
FAISS_INDEX_TYPE=flat_ip                 # flat_ip | ivf_flat | hnsw | auto
FAISS_IVF_NLIST=100                      # solo si FAISS_INDEX_TYPE=ivf_flat
FAISS_IVF_NPROBE=10                      # solo si FAISS_INDEX_TYPE=ivf_flat
FAISS_HNSW_M=32                          # solo si FAISS_INDEX_TYPE=hnsw
FAISS_IVF_AUTO_THRESHOLD=50000           # umbral para FAISS_INDEX_TYPE=auto
WORKING_INDEX_DIR=working_index          # índices de trabajo (modo operativo, con IndexIDMap)
DELIVERY_OUTPUT_DIR=base_vectorial       # artefactos finales de entrega (modo exportación)

